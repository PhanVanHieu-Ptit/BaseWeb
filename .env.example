# Copy this file to `.env` (git-ignored) and adjust the values.
# Only variables prefixed with VITE_ are exposed to the client.
# They are validated (src/config/env.schema.ts) when the dev server starts, at build time and at runtime.

# Display name of the application
VITE_APP_NAME=BaseWeb

# API base URL: an absolute URL, or a path (e.g. /api) when using a reverse proxy
VITE_API_BASE_URL=http://localhost:3000/api

# Request timeout in milliseconds
VITE_API_TIMEOUT_MS=15000

# Development only: intercept API calls in the browser with MSW (see src/mocks).
# Ignored by production builds.
VITE_ENABLE_MOCKS=true
